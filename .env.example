# Paradox ERP - Environment Variables
# Copy this file to `.env.local` and populate the values.

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-anon-key

# Server-only Secrets
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
N8N_WEBHOOK_SECRET=change-me-use-a-long-random-string
CRON_SECRET=change-me-use-a-long-random-string

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Integrations (Optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
RESEND_API_KEY=
EMAIL_FROM=
